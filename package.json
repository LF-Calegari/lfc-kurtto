{
  "name": "lfc-kurtto",
  "version": "0.1.0",
  "description": "Kurtto URL shortener service skeleton",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=source tsx watch --inspect=0.0.0.0:9229 src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "NODE_ENV=test NODE_OPTIONS=--conditions=source tsx --test test/*.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text --exclude 'src/migrations/**' npm run test",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run build && tsx ./node_modules/typeorm/cli.js migration:generate src/migrations/MigrationName -d dist/config/data-source.js",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "seed": "tsx src/seeds/url.seed.cli.entry.ts"
  },
  "imports": {
    "@config/*": {
      "source": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "@controllers/*": {
      "source": "./src/controllers/*.ts",
      "default": "./dist/controllers/*.js"
    },
    "@middlewares/*": {
      "source": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    },
    "@routes/*": {
      "source": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    }
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.4",
    "@types/node": "^24.8.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "c8": "^11.0.0",
    "eslint": "^9.38.0",
    "globals": "^17.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
