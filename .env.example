NODE_ENV=development
PORT=3000
# Encerramento ordenado (SIGTERM/SIGINT): tempo maximo em ms antes de exit 1 (padrao 30000)
# GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
# Winston: error | warn | info | http | verbose | debug | silly (opcional; sem LOG_LEVEL: debug em dev/test, info em production)
# LOG_LEVEL=debug
# Request log (GET): CSV de paths sem query a ignorar. Vazio = nao ignorar nenhuma. Ausente = ignora /api/v1/health, /live e /ready
# REQUEST_LOG_SKIP_PATHS=/api/v1/health
# CORS em producao: lista CSV de origens (obrigatorio se NODE_ENV=production). Em development/test, vazio = qualquer origem (*).
# CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
# Swagger UI (`/api/docs`, `/api/docs.json`): em production so ativo com `true`; em development/test padrao ligado; `false` desliga.
# SWAGGER_ENABLED=false
# Limites de taxa (memoria; para multi-instancia, planeje Redis/store compartilhado)
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_POST_URLS_MAX=10
# RATE_LIMIT_POST_URLS_WINDOW_MS=900000
# RATE_LIMIT_REDIRECT_MAX=60
# RATE_LIMIT_REDIRECT_WINDOW_MS=60000
# Opcional: se definido, tem precedencia sobre DB_* / POSTGRES_*
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kurtto
# Jest / integração: URL base do Postgres de teste (obrigatória para testes que usam useIntegrationDatabase),
# exceto se KURTTO_INTEGRATION_USE_ENV_DATABASE=true. O setup Jest deriva um banco por worker paralelo
# (ex.: kurtto_test_w1) a partir desta URL e replica em DATABASE_URL.
# KURTTO_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kurtto_test
# Legado (mesmo papel):
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/kurtto_test
# Avançado: permitir integração Jest usando só DATABASE_URL/DB_* (cuidado para não apontar ao banco de dev)
# KURTTO_INTEGRATION_USE_ENV_DATABASE=true
# Opcional: remove o banco de teste derivado (ex.: _w1, _w2) ao final de cada arquivo de teste.
# KURTTO_TEST_DATABASE_DROP_AFTER_RUN=true
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kurtto
# Base pública para montar short_url nas respostas (sem barra final recomendado)
BASE_URL=http://localhost:3000
# Tamanho do short code gerado automaticamente (3–10; padrão 7)
SHORT_CODE_LENGTH=7
# Opcional: cache de redirect com Redis (ioredis). Sem REDIS_URL a API usa só PostgreSQL.
# REDIS_URL=redis://localhost:6379
# TTL em segundos para chaves url:{code} (padrão 3600)
# REDIS_CACHE_TTL=3600
