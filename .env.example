NODE_ENV=development
PORT=3000
# Winston: error | warn | info | http | verbose | debug | silly (opcional; sem LOG_LEVEL: debug em dev/test, info em production)
# LOG_LEVEL=debug
# Request log (GET): CSV de paths sem query a ignorar. Vazio = nao ignorar nenhuma. Ausente = ignora /api/v1/health
# REQUEST_LOG_SKIP_PATHS=/api/v1/health
# CORS em producao: lista CSV de origens (obrigatorio se NODE_ENV=production). Em development/test, vazio = qualquer origem (*).
# CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
# Swagger UI (`/api/docs`, `/api/docs.json`): em production so ativo com `true`; em development/test padrao ligado; `false` desliga.
# SWAGGER_ENABLED=false
# Limites de taxa (memoria; para multi-instancia, planeje Redis/store compartilhado)
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_POST_URLS_MAX=10
# RATE_LIMIT_POST_URLS_WINDOW_MS=900000
# RATE_LIMIT_REDIRECT_MAX=60
# RATE_LIMIT_REDIRECT_WINDOW_MS=60000
# Opcional: se definido, tem precedencia sobre DB_* / POSTGRES_*
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kurtto
# Opcional: sobrescreve DATABASE_URL apenas na suíte Jest (helpers/env-test.ts)
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/kurtto_test
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kurtto
# Base pública para montar short_url nas respostas (sem barra final recomendado)
BASE_URL=http://localhost:3000
# Tamanho do short code gerado automaticamente (3–10; padrão 7)
SHORT_CODE_LENGTH=7
